# CardScout price mode. Leave as demo to use the built-in sample cards.
# demo        Practice prices. No keys. Values still shows three source boxes, marked Practice.
# live        TCGPlayer market via the Pokémon TCG API, plus PriceCharting and eBay sold when those keys are set.
# pokemontcg  Older name. Turns on live mode.
# ebay        Older name. Turns on live mode. Buy It Now asks are not the market price.
PRICE_PROVIDER=demo

# Optional. A free key from https://dev.pokemontcg.io raises rate limits.
# Live mode uses this API for card info and the TCGPlayer market price (recent sales).
# The API can be called without a key, but it may throttle or fail.
POKEMONTCG_API_KEY=

# PriceCharting Prices API. Paid subscription required.
# https://www.pricecharting.com/api-documentation
# On the subscription page, open API/Download and copy the token (sent as the `t` parameter).
# Without a token, the PriceCharting box on Values says it needs a key. No grades are invented.
PRICECHARTING_TOKEN=

# eBay keys from https://developer.ebay.com/ (client credentials).
# Used only when PRICE_PROVIDER=live (or the older ebay / pokemontcg settings).
#
# Values sold comps call Marketplace Insights item_sales search (completed sales).
# eBay has to approve that limited-release API for the application. If it is not
# approved, the eBay box says so. CardScout does not scrape sold listings, and it
# does not treat Buy It Now asking prices as sold prices or as the market.
#
# Deals may also show eBay Buy It Now asks next to the TCGPlayer market price.
# The crossed-out baseline stays TCGPlayer.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# PRODUCTION or SANDBOX. Defaults to PRODUCTION.
EBAY_ENV=PRODUCTION
