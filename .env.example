# CardScout price source. Leave as demo to use the built-in sample cards.
# demo        Practice prices shipped with the app. No key required.
# pokemontcg  Card info and TCGPlayer prices from https://pokemontcg.io
# ebay        eBay Buy It Now listings, compared with Pokémon TCG API market prices.
PRICE_PROVIDER=demo

# Optional. A free key from https://dev.pokemontcg.io raises rate limits.
# The Pokémon TCG API can be called without a key, but it may throttle or fail.
POKEMONTCG_API_KEY=

# Only used when PRICE_PROVIDER=ebay.
# Create keys at https://developer.ebay.com/ (Browse API, client credentials).
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# PRODUCTION or SANDBOX. Defaults to PRODUCTION.
EBAY_ENV=PRODUCTION
