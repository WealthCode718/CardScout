# Live mode turns on when TCGAPI_API_KEY is set, even if eBay is not connected yet.
# Practice numbers appear only when a configured live call fails.
#
# On Vercel now:
#   TCGAPI_API_KEY
# Add later, after eBay developer approval (about a day):
#   EBAY_CLIENT_ID
#   EBAY_CLIENT_SECRET
# Leave PRICECHARTING_TOKEN blank. Scrydex is optional and unused.

# Raw English TCGPlayer market, via tcgapi.dev.
# Signup: https://tcgapi.dev/
# Free tier: 100 requests/day, no credit card, non-commercial use.
# CardScout sends this as the X-API-Key header and caches each search for 12 hours.
# Docs: https://tcgapi.dev/authentication/ and https://tcgapi.dev/api/search/
# market_price is the TCGPlayer market (median of recent sales).
# low_price is the lowest list price. Leave blank and that box says Not configured.
TCGAPI_API_KEY=

# eBay sold comps. Client credentials from https://developer.ebay.com/.
# How to get them:
# 1. Create an application and a keyset (the Browse API client-credentials pair).
# 2. Copy the Client ID and Client Secret.
# 3. Ask eBay to allow Marketplace Insights for that app.
# Browse item_summary/search only returns active listings. It has no sold or
# completed filter, so CardScout does not use Buy It Now asks as sold prices.
# Sold search calls /buy/marketplace_insights/v1_beta/item_sales/search
# with scope https://api.ebay.com/oauth/api_scope/buy.marketplace.insights
# Graded comps are medians of those sold titles that say PSA, BGS, or CGC.
# Leave the keys blank and the boxes say "eBay sold: not connected yet".
# Live mode stays on from TCGAPI_API_KEY alone. No sold prices are invented.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# PRODUCTION or SANDBOX. Defaults to PRODUCTION.
EBAY_ENV=PRODUCTION

# Optional. Not used by the live path. A paid Scrydex plan would use these later.
# https://scrydex.com/
SCRYDEX_API_KEY=
SCRYDEX_TEAM_ID=

# Deferred. Not shown. No graded prices are invented from this token.
# https://www.pricecharting.com/api-documentation
PRICECHARTING_TOKEN=
